\@writefile{toc}{\contentsline {paragraph}{Turing-Trained Simulators are Most Human-Like.}{5}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Turing judge scores (1--7 Likert; higher = harder to distinguish from a real user) from Sonnet~4.6 on Chat and Reddit, with 95\% CIs. Hollow markers indicate untrained baselines, while solid markers denote trained Qwen3-8B variants. The dashed line with shaded band marks the Qwen3-8B base model performance with 95\% CI. \textbf  {LLMs trained with Turing rewards (Turing-RL) outperforms other training signals on human-likeness in both domains.}}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:turing_dot}{{2}{6}{Turing judge scores (1--7 Likert; higher = harder to distinguish from a real user) from Sonnet~4.6 on Chat and Reddit, with 95\% CIs. Hollow markers indicate untrained baselines, while solid markers denote trained Qwen3-8B variants. The dashed line with shaded band marks the Qwen3-8B base model performance with 95\% CI. \textbf {LLMs trained with Turing rewards (Turing-RL) outperforms other training signals on human-likeness in both domains.}}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Response similarity to ground truth (Sim, \%; higher = more similar to what the user actually said) from Sonnet~4.6 on Chat and Reddit, with 95\% CIs. Hollow markers indicate untrained baselines, while solid markers denote trained Qwen3-8B variants. The dashed line with shaded band marks the Qwen3-8B base model performance with 95\% CI. \textbf  {Turing-RL matches Sim-RL even though Sim-RL is explicitly trained to maximize similarity}, showing that optimizing for indistinguishability does not sacrifice content alignment.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:sim_dot}{{3}{6}{Response similarity to ground truth (Sim, \%; higher = more similar to what the user actually said) from Sonnet~4.6 on Chat and Reddit, with 95\% CIs. Hollow markers indicate untrained baselines, while solid markers denote trained Qwen3-8B variants. The dashed line with shaded band marks the Qwen3-8B base model performance with 95\% CI. \textbf {Turing-RL matches Sim-RL even though Sim-RL is explicitly trained to maximize similarity}, showing that optimizing for indistinguishability does not sacrifice content alignment}{figure.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Turing-Trained Model Generations are Similar to Ground Truth.}{6}{section*.11}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Turing-Trained Model Generations are Specific to Users and Contexts.}{6}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Response specificity ($[0,1]$; higher = more grounded in the interaction context and compatible with the target user) from Sonnet~4.6, with 95\% CIs. Hollow markers indicate untrained baselines, while solid markers denote trained Qwen3-8B variants. GT is the ground truth human response, and the dashed line marks the Qwen3-8B base model with 95\% CI. \textbf  {Turing-RL is among the strongest on Chat, while Turing-RL and Sim-RL are strongest among the trained models on Reddit}, outperforming SFT-Init and Logprob-RL.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:specificity}{{4}{7}{Response specificity ($[0,1]$; higher = more grounded in the interaction context and compatible with the target user) from Sonnet~4.6, with 95\% CIs. Hollow markers indicate untrained baselines, while solid markers denote trained Qwen3-8B variants. GT is the ground truth human response, and the dashed line marks the Qwen3-8B base model with 95\% CI. \textbf {Turing-RL is among the strongest on Chat, while Turing-RL and Sim-RL are strongest among the trained models on Reddit}, outperforming SFT-Init and Logprob-RL}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Comparing human and LLM judge accuracy at identifying the real user's response.} For each of 50 target users per domain, we take the majority vote from ${\sim }6$ human annotators (solid) and from the Sonnet~4.6 Turing judge. \textit  {GT Accuracy} is the fraction of targets correctly identified. Both evaluators agree that Turing-RL is the hardest model to distinguish from real users. \textbf  {Sonnet~4.6 matches or exceeds human accuracy in most conditions, supporting its use as an automatic evaluation proxy.}}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:binary_gt_accuracy}{{5}{7}{\textbf {Comparing human and LLM judge accuracy at identifying the real user's response.} For each of 50 target users per domain, we take the majority vote from ${\sim }6$ human annotators (solid) and from the Sonnet~4.6 Turing judge. \textit {GT Accuracy} is the fraction of targets correctly identified. Both evaluators agree that Turing-RL is the hardest model to distinguish from real users. \textbf {Sonnet~4.6 matches or exceeds human accuracy in most conditions, supporting its use as an automatic evaluation proxy.}}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Human Evaluation}{7}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Human Turing Test, model win rates against ground truth ($\pm $ 95\% CI). Best results (up to statistical significance) are bolded. Turing-RL greatly improves over SFT-Init on both domains. }}{7}{table.1}\protected@file@percent }
\newlabel{tab:human_eval_winrate}{{1}{7}{Human Turing Test, model win rates against ground truth ($\pm $ 95\% CI). Best results (up to statistical significance) are bolded. Turing-RL greatly improves over SFT-Init on both domains}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Ablation on user representation for Turing-RL. We compare three input conditions: history and persona $u = (h, \rho )$, history only $u = h$, and persona only $u = \rho $. Values are mean $\pm $ 95\% CI half-width; Turing is on a 1--7 scale, Sim is reported as a percentage, and Specificity is in $[0,1]$.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:ablation_combined}{{2}{8}{Ablation on user representation for Turing-RL. We compare three input conditions: history and persona $u = (h, \rho )$, history only $u = h$, and persona only $u = \rho $. Values are mean $\pm $ 95\% CI half-width; Turing is on a 1--7 scale, Sim is reported as a percentage, and Specificity is in $[0,1]$}{table.2}{}}
